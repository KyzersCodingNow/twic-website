# Beehiiv newsletter embed URL (iframe src). If unset, a styled placeholder form is shown.
NEXT_PUBLIC_BEEHIIV_URL=

# Email address used by the "Become a sponsor" mailto link.
NEXT_PUBLIC_SPONSOR_EMAIL=sponsors@thisweekincrypto.show

# Canonical site URL, used for metadata / sitemap. Defaults to production URL if unset.
NEXT_PUBLIC_SITE_URL=https://thisweekincrypto.show

# --- $ALL economy (/all) ---
# The Flipcash token page — the single "Get $ALL on Flipcash" hand-off.
NEXT_PUBLIC_FLIPCASH_URL=https://app.flipcash.com/token/8Rr5EfMZHDiwc7bqMP6wyJRcG9BRovfWseqNtYrCCpwv
# The $ALL Solana mint, used server-side to look up a live spend price.
NEXT_PUBLIC_ALL_MINT=8Rr5EfMZHDiwc7bqMP6wyJRcG9BRovfWseqNtYrCCpwv
# Arm's-length enquiry inbox for advertising / spotlight bids (falls back to NEXT_PUBLIC_SPONSOR_EMAIL).
NEXT_PUBLIC_ALL_ADS_EMAIL=ads@thisweekincrypto.show
