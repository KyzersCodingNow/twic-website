# Beehiiv newsletter embed URL (iframe src). If unset, a styled placeholder form is shown.
NEXT_PUBLIC_BEEHIIV_URL=

# Email address used by the "Become a sponsor" mailto link.
NEXT_PUBLIC_SPONSOR_EMAIL=sponsors@thisweekincrypto.show

# Canonical site URL, used for metadata / sitemap. Defaults to production URL if unset.
NEXT_PUBLIC_SITE_URL=https://thisweekincrypto.show
